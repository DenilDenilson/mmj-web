---
import Layout from "@src/layouts/Layout.astro";
import Hero from "@src/components/Course/Hero.astro";
import Info from "@src/components/Course/Info.astro";
import Temario from "@src/components/Course/Temario.astro";
import Kit from "@src/components/Course/Kit.astro";
import { getCollection } from "astro:content";

const { course } = Astro.params;

export async function getStaticPaths() {
  const courseEntries = await getCollection("courses");

  return courseEntries.map((entry: any) => ({
    params: {
      carrera: entry.id.split("/")[0],
      course: entry.id.split("/")[1],
    },
  }));
  // return [{ params: { carrera: "embebido", course: "ansi-c" } }];
}
---

<Layout title={course}>
  <Hero />
  <div class="course-main mx-auto max-w-7xl lg:flex">
    <Info />
    <Temario />
  </div>
  <Kit />
  <!-- <Projects /> -->
  <!-- <OtherCourses /> -->
</Layout>

<script>
  const courseRevealItems = document.querySelectorAll<HTMLElement>(
    "[data-course-reveal]",
  );

  const showCourseItem = (item: HTMLElement) => {
    item.classList.add("is-visible");
  };

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    courseRevealItems.forEach(showCourseItem);
  } else if ("IntersectionObserver" in window) {
    const courseRevealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          showCourseItem(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        });
      },
      {
        rootMargin: "0px 0px -10% 0px",
        threshold: 0.12,
      },
    );

    courseRevealItems.forEach((item) => courseRevealObserver.observe(item));
  } else {
    courseRevealItems.forEach(showCourseItem);
  }
</script>
