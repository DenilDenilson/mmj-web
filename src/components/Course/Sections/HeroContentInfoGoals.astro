---
import Check from "@src/Images/icons/Check.astro";

const { goals } = Astro.props;
---

<ul class="course-goals mb-6 lg:mb-4">
  <p class="mb-1 text-black-500">¿Qué lograrás en este curso?</p>
  {
    goals?.map((goal: string) => (
      <li class="mb-1 flex items-center gap-1">
        <div class="grid h-5 w-5 place-content-center">
          <Check />
        </div>
        <span class="font-light text-black-500">{goal}</span>
      </li>
    ))
  }
</ul>

<style>
  .course-goals :global(li) {
    opacity: 0;
    transform: translateX(-12px);
    animation: course-goal-enter 440ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .course-goals :global(li:nth-of-type(1)) {
    animation-delay: 760ms;
  }

  .course-goals :global(li:nth-of-type(2)) {
    animation-delay: 840ms;
  }

  .course-goals :global(li:nth-of-type(3)) {
    animation-delay: 920ms;
  }

  .course-goals :global(li:nth-of-type(4)) {
    animation-delay: 1000ms;
  }

  @keyframes course-goal-enter {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }

    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .course-goals :global(li) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
