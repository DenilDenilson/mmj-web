---
import TemarioModulo from "./Sections/TemarioModulo.astro";

import { getEntry } from "astro:content";

const { carrera, course } = Astro.params;
const specificCourse = await getEntry("courses", `${carrera}/${course}`);
const { temarioLink, temario } = specificCourse?.data || {};
---

<section class="course-temario lg:max-w-md" data-course-reveal>
  <div class="px-7 py-6">
    {
      temario?.map((modulo, index) => (
        <TemarioModulo
          key={index}
          index={index}
          startOpen={index === 0}
          modulo={modulo}
        />
      ))
    }
    <a
      href={temarioLink}
      target="_blank"
      class="course-temario-download mx-6 my-3 block rounded-md border border-black-300 px-6 py-3 text-center text-black-300 transition-all duration-300 hover:bg-black-50"
    >
      Descargar temario completo
    </a>
  </div>
</section>

<style>
  .course-temario {
    opacity: 0;
    transform: translateX(34px);
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .course-temario.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .course-temario-download {
    opacity: 0;
    transform: translateY(16px);
  }

  .course-temario.is-visible .course-temario-download {
    animation: temario-download-enter 520ms cubic-bezier(0.22, 1, 0.36, 1) 420ms
      both;
  }

  @keyframes temario-download-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .course-temario,
    .course-temario-download {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
