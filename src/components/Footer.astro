---
import { Image } from "astro:assets";
import MMJLogoFooter from "../Images/LogoMMJ-white.png";
import Mobile from "../Images/icons/Mobile.astro";
import PinMap from "../Images/icons/PinMap.astro";
import Mail from "../Images/icons/Mail.astro";
import Clock from "../Images/icons/Clock.astro";
import Facebook from "../Images/icons/Facebook.astro";
import Youtube from "../Images/icons/Youtube.astro";
import Instagram from "../Images/icons/Instagram.astro";
import TikTok from "@src/Images/icons/TikTok.astro";

const utilsLinks = [
  { title: "Inicio", link: "/" },
  { title: "Soluciones de Hardware", link: "/servicio-hardware" },
  { title: "Soluciones de Software", link: "/servicio-software" },
  { title: "Soluciones de IoT", link: "/servicio-iot" },
  { title: "Consultoría", link: "/consultoria" },
  { title: "Contáctanos", link: "https://wa.link/fc3qb5" },
];

const SocialMediaLinks = [
  {
    title: "Facebook",
    link: "https://www.facebook.com/mmj.smart",
    icon: Facebook,
  },
  {
    title: "TikTok",
    link: "https://www.tiktok.com/@mmj_smartelectronics",
    icon: TikTok,
  },
  {
    title: "YouTube",
    link: "https://www.youtube.com/@mmjsmartelectronics4335/featured",
    icon: Youtube,
  },
  {
    title: "Instagram",
    link: "https://www.instagram.com/mmj_smart_electronics/",
    icon: Instagram,
  },
];
---

<footer class="bg-black-700 text-white-200">
  <div
    class="mx-auto flex max-w-7xl flex-col items-start justify-between px-8 pb-8 pt-16 lg:flex-row"
  >
    <section class="mb-8 max-w-80">
      <div class="mb-6">
        <Image
          src={MMJLogoFooter}
          alt="Logo de MMJ Smart Electronics en el footer"
        />
      </div>
      <hgroup class="mb-4">
        <h3 class="mb-2 font-bold text-secondary-500">Misión</h3>
        <p class="font-light leading-5">
          Impulsar el desarrollo tecnológico y transformar vidas mediante
          formación de alto nivel en ingeniería, sistemas embebidos e IoT, y el
          diseño de soluciones innovadoras y personalizadas que satisfagan las
          necesidades de nuestros clientes.
        </p>
      </hgroup>
      <hgroup>
        <h3 class="mb-2 font-bold text-secondary-500">Visión</h3>
        <p class="font-light leading-5">
          Ser el líder indiscutible en innovación tecnológica en la región,
          reconocido por nuestra excelencia, sostenibilidad y compromiso con el
          desarrollo del talento local.
        </p>
      </hgroup>
    </section>
    <section class="mb-8">
      <h3 class="mb-2 font-bold text-secondary-500">Enlaces Útiles</h3>
      <ul class="flex flex-col gap-2">
        {
          utilsLinks.map((item) => (
            <li>
              <a href={item.link} class="group relative font-light">
                {item.title}
                <span class="absolute bottom-0 left-0 h-[2px] w-0 bg-white-200 transition-all duration-200 group-hover:w-full" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    <section>
      <h3 class="mb-6 font-bold text-secondary-500">
        Nos puedes contactar a través de:
      </h3>
      <ul class="mb-8 flex flex-col gap-2">
        <li class="flex items-center gap-1">
          <Mobile />
          <div class="flex flex-col">
            <p class="font-light">+51 970 570 927</p>
            <p class="font-light">+51 961 188 601</p>
          </div>
        </li>
        <li class="flex items-center gap-1">
          <PinMap />
          <p class="font-light">Av Perú 1716 SMP, Lima – Perú</p>
        </li>
        <li class="flex items-center gap-1">
          <Mail />
          <div class="flex flex-col">
            <p class="font-light">proyectos.smartelec@gmail.com</p>
            <p class="font-light">mmj.cursos@gmail.com</p>
          </div>
        </li>
        <li class="flex items-center gap-1">
          <Clock />
          <p class="font-light">Lunes a Sábado de 09:00 a.m. - 07:00 p.m.</p>
        </li>
      </ul>
    </section>
    <h3
      class="mx-auto mb-6 text-center font-bold text-secondary-500 lg:text-start"
    >
      Nuestras redes sociales
    </h3>
    <ul class="mx-auto flex justify-center gap-4 lg:justify-start">
      {
        SocialMediaLinks.map((socialLink) => (
          <li>
            <a href={socialLink.link} target="_blank" rel="noopener noreferrer">
              <socialLink.icon />
            </a>
          </li>
        ))
      }
      <TikTok />
    </ul>
    <!-- <a
        href="https://www.youtube.com/@mmjsmartelectronics4335/featured"
        target="_blank"
      >
        <Youtube />
      </a>
      <a
        href="https://www.instagram.com/mmj_smart_electronics/"
        target="_blank"
      >
        <Instagram />
      </a> -->
  </div>
</footer>
