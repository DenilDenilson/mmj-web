---
import Durability from "@src/Images/icons/Durability.astro";
import Integration from "@src/Images/icons/Integration.astro";
import OptimizationResources from "@src/Images/icons/OptimizationResources.astro";
import Scalability from "@src/Images/icons/Scalability.astro";
import { getEntry } from "astro:content";

const { service } = Astro.params;
const specificService = await getEntry("services", `${service}`);
const { highlights = [] } = specificService?.data || {}; // Aseguramos que highlights sea un array vacío en caso de null o undefined

const items = [
  {
    Icon: OptimizationResources,
    title: highlights[0]?.title ?? "Optimización de Recursos",
    description:
      highlights[0]?.description ??
      "Maximiza el rendimiento y la eficiencia con componentes diseñados específicamente para tus necesidades",
    colorClass: "text-[#6E3C9F]",
  },
  {
    Icon: Integration,
    title: highlights[1]?.title ?? "Integración Precisa",
    description:
      highlights[1]?.description ??
      "Soluciones integradas con exactitud a tus equipos y sistemas actuales",
    colorClass: "text-[#009B7C]",
  },
  {
    Icon: Durability,
    title: highlights[2]?.title ?? "Durabilidad y Confiabilidad",
    description:
      highlights[2]?.description ??
      "Componentes de alta calidad que ofrecen un rendimiento duradero y constante",
    colorClass: "text-primary-500",
  },
  {
    Icon: Scalability,
    title: highlights[3]?.title ?? "Escalabilidad Personalizada",
    description:
      highlights[3]?.description ??
      "Diseñado para crecer con tus proyectos, adaptable a futuras necesidades",
    colorClass: "text-[#57A6B8]",
  },
];
---

<section
  class="service-highlights relative z-50 grid place-content-center overflow-hidden bg-black-800 px-8 py-8 shadow-[0_16px_32px_0_rgba(12,12,13,0.1),0_4px_4px_0_rgba(12,12,13,0.05)]"
  aria-label="Beneficios destacados del servicio"
  data-service-reveal
>
  <ul
    class="mx-auto flex w-full snap-x snap-mandatory items-center gap-10 overflow-x-auto"
  >
    {
      items.map(({ Icon, title, description, colorClass }, index) => (
        <>
          <li
            class="highlight-item flex w-[270px] min-w-[270px] snap-center flex-col items-center gap-5 text-center"
            style={`--highlight-delay: ${index * 90}ms`}
          >
            <div class="grid h-24 w-24 place-content-center brightness-0 invert [&>svg]:h-24 [&>svg]:w-24">
              <Icon />
            </div>
            <div class="flex w-full flex-col items-center justify-center gap-2.5 leading-tight">
              <h3
                class:list={[
                  "w-full text-2xl font-semibold leading-tight",
                  colorClass,
                ]}
              >
                {title}
              </h3>
              <p class="w-full text-base font-light leading-tight text-white-200">
                {description}
              </p>
            </div>
          </li>
          {index < items.length - 1 && (
            <li
              class="highlight-divider h-[209px] min-w-0 border-l-2 border-secondary-500"
              style={`--highlight-delay: ${index * 90 + 70}ms`}
              aria-hidden="true"
              role="presentation"
            />
          )}
        </>
      ))
    }
  </ul>
</section>

<style>
  .service-highlights {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-highlights.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .highlight-item,
  .highlight-divider {
    --highlight-delay: 0ms;
    opacity: 0;
    transform: translateY(20px);
  }

  .service-highlights.is-visible .highlight-item,
  .service-highlights.is-visible .highlight-divider {
    animation: highlight-item-enter 560ms cubic-bezier(0.22, 1, 0.36, 1)
      var(--highlight-delay) both;
  }

  .service-highlights.is-visible .highlight-divider {
    transform-origin: center;
    animation-name: highlight-divider-enter;
  }

  @keyframes highlight-item-enter {
    from {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes highlight-divider-enter {
    from {
      opacity: 0;
      transform: scaleY(0.65);
    }

    to {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-highlights,
    .highlight-item,
    .highlight-divider {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
      filter: none;
    }
  }
</style>
