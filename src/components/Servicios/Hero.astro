---
import HeroInfo from "./Sections/HeroInfo.astro";
import HeroImage from "./Sections/HeroImage.astro";
import BgService from "@src/Images/Servicios/Hardware/BgNewBase.png";
import { Image } from "astro:assets";
---

<section class="service-hero relative">
  <div class="h-12 w-full"></div>
  <!-- Pequeño cuadro para bajar el resto del espacio que oculata la barra de navegación fija -->
  <div
    class="service-hero-inner relative mx-auto max-w-7xl overflow-x-hidden sm:flex"
  >
    <HeroInfo />
    <HeroImage />
  </div>
  <Image
    src={BgService}
    alt="Imagen de fondo de los servicios"
    class="service-hero-bg absolute top-0 hidden lg:block"
  />
  <div class="absolute top-0 h-full w-full bg-black-900 opacity-5"></div>
</section>

<style>
  .service-hero {
    overflow: hidden;
  }

  .service-hero-inner {
    isolation: isolate;
  }

  .service-hero-bg {
    animation: service-bg-enter 1400ms cubic-bezier(0.16, 1, 0.3, 1) both;
    transform-origin: left top;
  }

  @keyframes service-bg-enter {
    from {
      opacity: 0;
      transform: translateX(-24px) scale(1.04);
      filter: blur(8px);
    }

    to {
      opacity: 1;
      transform: translateX(0) scale(1);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero-bg {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
