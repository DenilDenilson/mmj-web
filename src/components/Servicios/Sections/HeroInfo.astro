---
import { getEntry } from "astro:content";
import HeroInfoHeader from "./HeroInfoHeader.astro";
import HeroInfoDescription from "./HeroInfoDescription.astro";
import SolicitaColsultoriaButton from "../Atoms/SolicitaColsultoriaButton.astro";

const { service } = Astro.params;
const specificService = await getEntry("services", `${service}`); // Recordar que el slug es el nombre del archivo

const { title, subtitle, description } = specificService?.data || {};
---

<div
  class="service-hero-info z-10 max-w-3xl px-4 pb-28 pt-8 sm:relative sm:flex-1 sm:pb-32 lg:pb-24"
>
  <div class="service-hero-copy-step">
    <HeroInfoHeader title={title} subtitle={subtitle} />
  </div>
  <div class="service-hero-copy-step">
    <HeroInfoDescription description={description} />
  </div>
  <div class="service-hero-copy-step">
    <SolicitaColsultoriaButton
      link="https://wa.link/fc3qb5"
      text="¡Solicita una consultoría ahora!"
    />
  </div>
</div>

<style>
  .service-hero-copy-step {
    opacity: 0;
    transform: translateY(26px);
    animation: service-hero-copy-enter 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .service-hero-copy-step:nth-child(1) {
    animation-delay: 140ms;
  }

  .service-hero-copy-step:nth-child(2) {
    animation-delay: 280ms;
  }

  .service-hero-copy-step:nth-child(3) {
    animation-delay: 420ms;
  }

  @keyframes service-hero-copy-enter {
    from {
      opacity: 0;
      transform: translateY(26px);
      filter: blur(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-hero-copy-step {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
