---
import TarjetaServiciosBg from "@src/Images/Home/TarjetaServicios.avif";
import PuzzleConsulting from "@src/Images/icons/PuzzleConsulting.astro";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  url: string;
  video: string;
  implications: string[];
  beneficts: any[];
  "data-index"?: string;
}

const {
  title,
  description,
  url,
  video,
  implications,
  beneficts,
  "data-index": dataIndex,
} = Astro.props;
---

<section class="px-4" data-index={dataIndex}>
  <div class="lg:mb-12 lg:mt-16 lg:flex lg:items-start lg:gap-12">
    <div>
      <h4
        class="text-3xl font-bold leading-tight text-secondary-400 md:leading-normal lg:text-5xl"
      >
        {title}
      </h4>
      <p
        class="my-4 max-w-3xl text-pretty text-xl leading-snug text-black-800 md:leading-normal"
      >
        {description}
      </p>
      <a
        href={url}
        class="h-8 place-content-center rounded bg-primary-400 px-4 py-2 text-white-300 lg:h-10"
        >Ir a Solución</a
      >
    </div>
    <div class="my-8 aspect-video w-full rounded-lg bg-white-800 lg:m-0">
      VIDEO
    </div>
  </div>
  <h5 class="text-center text-2xl font-bold text-primary-500">¿Qué implica?</h5>
  <ul
    class="scroll-hidden my-6 flex snap-x snap-mandatory gap-4 overflow-x-auto lg:grid lg:grid-cols-3 lg:grid-rows-2 lg:gap-4"
  >
    {
      implications.map((implication: any) => (
        <li class="relative flex h-24 min-w-72 snap-center items-center gap-2 rounded-md bg-white-900">
          <Image
            src={TarjetaServiciosBg}
            alt="Fondo de tarjeta de servicio"
            class="absolute inset-0 h-full w-full rounded-md object-cover object-center"
          />
          <div class="absolute inset-0 rounded-md bg-black-900/50" />
          <PuzzleConsulting extraClass="scale-50 lg:scale-[65%]" />
          <p class="relative text-sm font-normal leading-tight text-white-50 lg:text-xl">
            {implication}
          </p>
        </li>
      ))
    }
  </ul>
  <h4 class="text-center text-2xl font-bold text-primary-500">
    Beneficios de implementar una solución a medida
  </h4>
  <ul
    class="scroll-hidden my-6 flex snap-x snap-mandatory gap-4 overflow-x-auto lg:justify-evenly"
  >
    {
      beneficts.map((benefit: any) => (
        <li class="flex h-72 w-52 min-w-52 snap-center flex-col items-center justify-center rounded-lg border-4 border-solid border-white-800 p-4 text-center lg:h-72 lg:w-80">
          <div class="grid place-content-center lg:hidden">
            <benefit.icon fill="#1D7988" />
          </div>
          <div class="hidden place-content-center lg:grid">
            <benefit.icon fill="#1f2937" width="128" height="128" />
          </div>
          <h5 class="text-xl font-medium text-black-500">{benefit.title}</h5>
          <p class="text-base font-light text-black-500">
            {benefit.description}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Oculta scrollbar en Chrome, Safari y Edge */
  .scroll-hidden::-webkit-scrollbar {
    display: none;
  }

  /* Oculta scrollbar en Firefox */
  .scroll-hidden {
    scrollbar-width: none;
  }

  /* IE y Edge antiguo */
  .scroll-hidden {
    -ms-overflow-style: none;
  }
</style>
