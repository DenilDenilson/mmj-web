---
import Antena from "@src/Images/icons/Antena.astro";
import Lupa from "@src/Images/icons/Lupa.astro";
import ControlRemoto from "@src/Images/icons/ControlRemoto.astro";
import BolsaDinero from "@src/Images/icons/BolsaDinero.astro";
import Analitics from "@src/Images/icons/Analitics.astro";
import Bulb from "@src/Images/icons/Bulb.astro";
import CheckChip from "@src/Images/icons/CheckChip.astro";
import Chip from "@src/Images/icons/Chip.astro";
import Clock from "@src/Images/icons/Clock.astro";
import Cloud from "@src/Images/icons/Cloud.astro";
import Integration from "@src/Images/icons/Integration.astro";
import Iot from "@src/Images/icons/Iot.astro";
import Mobile from "@src/Images/icons/Mobile.astro";
import Pcb from "@src/Images/icons/Pcb.astro";
import Printer3D from "@src/Images/icons/Printer3D.astro";
import Software from "@src/Images/icons/Software.astro";
import Warning from "@src/Images/icons/Warning.astro";
import SolutionHome from "./SolutionHome.astro";

const Solutions = [
  {
    title: "Diseño de soluciones IoT",
    description:
      "Diseñamos y desarrollamos soluciones a medida que se adaptan a tus necesidades específicas, desde software especializado hasta hardware y dispositivos IoT interconectados",
    url: "",
    video: "",
    implications: [
      { text: "Monitoreo de señales analógicas", icon: Analitics },
      { text: "Diseño de arquitectura IoT personalizada", icon: Iot },
      { text: "Desarrollo de sensores y dispositivos inteligentes", icon: Chip },
      { text: "Implemantación de plataforma de gestión de datos", icon: Cloud },
      { text: "Integración con sistemas existentes", icon: Integration },
      { text: "Pruebas de conectividad y seguridad", icon: Warning },
    ],
    beneficts: [
      {
        title: "Monitoreo en tiempo real",
        description:
          "Acceso a datos en vivo para una toma de decisiones más rápida y eficaz.",
        icon: Antena,
      },
      {
        title: "Automatización de procesos",
        description:
          "Optimización de operaciones mediante la automatización de tareas repetitivas.",
        icon: Lupa,
      },
      {
        title: "Mantenimiento predictivo",
        description:
          "Identificación temprana de problemas para reducir tiempos de inactividad.",
        icon: ControlRemoto,
      },
      {
        title: "Mejora en la eficiencia operativa",
        description:
          "Optimización de recursos y reducción de costos operativos.",
        icon: BolsaDinero,
      },
    ],
  },
  {
    title: "Desarrollo de Hardware",
    description:
      "Diseñamos hardware personalizado para distintos campos de la industria. Somos expertos en el diseño y fabricación de PCBs de alta calidad, adaptados a las necesidades del cliente. Además, ofrecemos servicios de ensamblaje para asegurar una solución completa y eficiente.",
    url: "",
    video: "",
    implications: [
      { text: "Diseño electrónico de tarjetas PCBs", icon: Pcb },
      { text: "Fabricación local e internacional de tarjetas PCBs", icon: Chip },
      { text: "Ensamblaje y testeo de tarjetas PCBs", icon: CheckChip },
      { text: "Ingeniería inversa de quipos electrónicos", icon: Lupa },
      { text: "Desarrollo de productos electrónicos personalizados", icon: Bulb },
      { text: "Diseño mecánico e impresión 3D", icon: Printer3D },
    ],
    beneficts: [
      {
        title: "Personalización Total",
        description: "PCBs adaptadas a tus necesidades.",
        icon: Antena,
      },
      {
        title: "Calidad y Precisión",
        description: "Fabricación y ensamblake bajo normativas.",
        icon: Lupa,
      },
      {
        title: "Eficiencia",
        description: "Reducción de costos y tiempos.",
        icon: ControlRemoto,
      },
      {
        title: "Escalabilidad",
        description:
          "Optimización de recursos y reducción de costos operativos.",
        icon: BolsaDinero,
      },
    ],
  },
  {
    title: "Desarrollo de Software",
    description:
      "Ofrecemos soluciones de software personalizadas para diversas industrias, adaptándonos a las necesidades específicas de cada cliente. Nos especializamos en la optimización de procesos, monitoreo y automatización, garantizando eficiencia y crecimiento de tu proceso o negocio.",
    url: "",
    video: "",
    implications: [
      { text: "Programación de microcontroladores", icon: Chip },
      { text: "Desarrollo de software industrial", icon: Software },
      { text: "Desarrollo de aplicaciones Web IoT en la nube o local", icon: Cloud },
      { text: "Desararollo de plataformas de gestión de datos", icon: Analitics },
      { text: "Desarrollo de aplicaciones móviles", icon: Mobile },
      { text: "Implemantación de sistemas operativos en tiempo real", icon: Clock },
    ],
    beneficts: [
      {
        title: "Optimización de Procesos",
        description:
          "Mejora en productividad y eficiencia mediante software a medida.",
        icon: Antena,
      },
      {
        title: "Automatización de procesos",
        description:
          "Reducción de intervención manual y errores mediante la automatización de tareas repetitivas.",
        icon: Lupa,
      },
      {
        title: "Escalabilidad y Flexibilidad",
        description: "Adaptable a distintos entornos y necesidades.",
        icon: ControlRemoto,
      },
      {
        title: "Control centralizado",
        description:
          "Monitoreo y gestión integrada de los procesos en tiempo real.",
        icon: BolsaDinero,
      },
    ],
  },
];
---

<section>
  {
    Solutions.map((solution: any, index: number) => (
      <SolutionHome
        title={solution.title}
        description={solution.description}
        url={solution.url}
        video={solution.video}
        implications={solution.implications}
        beneficts={solution.beneficts}
        data-index={index + 1}
      />
    ))
  }
</section>

<style is:global>
  /* Ocultar todas las soluciones por defecto */
  #solutions-slider [data-index] {
    display: none;
  }

  /* Mostrar la primera solución por defecto */
  #solutions-slider [data-index="1"] {
    display: block;
  }

  /* Mostrar solución 1 cuando se selecciona */
  #solutions-slider
    input:nth-child(1):checked
    ~ section
    ~ section
    [data-index="1"] {
    display: block;
  }

  /* Ocultar otras soluciones cuando se selecciona la 1 */
  #solutions-slider
    input:nth-child(1):checked
    ~ section
    ~ section
    [data-index]:not([data-index="1"]) {
    display: none;
  }

  /* Mostrar solución 2 cuando se selecciona */
  #solutions-slider
    input:nth-child(2):checked
    ~ section
    ~ section
    [data-index="2"] {
    display: block;
  }

  /* Ocultar otras soluciones cuando se selecciona la 2 */
  #solutions-slider
    input:nth-child(2):checked
    ~ section
    ~ section
    [data-index]:not([data-index="2"]) {
    display: none;
  }

  /* Mostrar solución 3 cuando se selecciona */
  #solutions-slider
    input:nth-child(3):checked
    ~ section
    ~ section
    [data-index="3"] {
    display: block;
  }

  /* Ocultar otras soluciones cuando se selecciona la 3 */
  #solutions-slider
    input:nth-child(3):checked
    ~ section
    ~ section
    [data-index]:not([data-index="3"]) {
    display: none;
  }

  /* Estilos para los botones seleccionados */
  #solutions-slider .solution-option {
    transition: all 0.3s ease;
  }

  #solutions-slider
    input:nth-child(1):checked
    ~ section
    .solution-option:nth-child(1),
  #solutions-slider
    input:nth-child(2):checked
    ~ section
    .solution-option:nth-child(2),
  #solutions-slider
    input:nth-child(3):checked
    ~ section
    .solution-option:nth-child(3) {
    background-color: #c40b2a;
    color: white;
    border-color: #c40b2a;
  }
</style>
