      <input
        type="email"
        id="email"
        name="email"
        class="px-2 py-2 border-white-200 focus:border-[#1D7A8A] invalid:border-[#C82323] border-b-2 rounded-lg invalid:text-[#C82323]"
      />
    </div> -->
    <div class="flex flex-col gap-1 lg:col-span-3">
