---
import UbicationForm from "./UbicationForm.astro";
---

<div class="ubication-form-wrap mx-auto flex flex-col">
  <UbicationForm />
</div>

<style>
  .ubication-form-wrap {
    opacity: 0;
    transform: translateY(26px);
  }

  :global(.ubication-content.is-visible) .ubication-form-wrap {
    animation: ubication-form-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) 340ms
      both;
  }

  @keyframes ubication-form-enter {
    from {
      opacity: 0;
      transform: translateY(26px);
      filter: blur(6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ubication-form-wrap {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>
