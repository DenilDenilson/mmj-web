---
import HeroHome from "../Atoms/HeroHome.astro";
import bgHomeHero1 from "@src/Images/Home/bg-HomeHero1-v2.avif";
import bgHomeHeroDesktop1 from "@src/Images/Home/bgHomeHeroDesktop1-v2.avif";
import bgHomeHero2 from "@src/Images/Home/bg-HomeHero2-v2.avif";
import bgHomeHeroDesktop2 from "@src/Images/Home/bgHomeHeroDesktop2-v2.avif";
import bgHomeHero3 from "@src/Images/Home/bg-HomeHero3-v2.avif";
import bgHomeHeroDesktop3 from "@src/Images/Home/bgHomeHeroDesktop3-v2.avif";

const Heros = [
  {
    title: "Potencia tu empresa con Soluciones Tecnológicas a la Medida",
    description:
      "Diseñamos soluciones personalizadas en Hardware; Software e loT, combinando tecnología de vanguardia para llevar tus ideas al siguiente nivel y convertirlas en resultados efectivos para la industria y el comercio.",
    bgImage: bgHomeHero3,
    bgImageDesktop: bgHomeHeroDesktop3,
  },
  {
    title: "Tu camino hacia la especialización Comienza aquí",
    description:
      "Potencia tu futuro con nuestras líneas de carrera en Hardware, Software, Microcontroladores e Internet de las cosas, donde aprenderás con expertos en tecnología a diseñar, programar e innovar para enfrentar los retos de la industria actual.",
    bgImage: bgHomeHero1,
    bgImageDesktop: bgHomeHeroDesktop1,
  },
  {
    title: "Consultoría especializada Para Impulsar proyectos Tecnológicos",
    description:
      "Ofrecemos asesoría profesional a empresas y estudiantes para desarrollar soluciones innovadoras en hardware, software y tecnologías IoT, adaptadas a los desafíos y necesidades del mercado actual. ¡Haz realidad tus ideas con el respaldo de expertos en tecnología!",
    bgImage: bgHomeHero2,
    bgImageDesktop: bgHomeHeroDesktop2,
  },
];
---

<div id="sliderControl" class="">
  <input
    class="hidden"
    checked
    type="radio"
    name="heroSelector"
    id="heroSelector1"
  />
  <input class="hidden" type="radio" name="heroSelector" id="heroSelector2" />
  <input class="hidden" type="radio" name="heroSelector" id="heroSelector3" />
  <div id="heroSlider" class="overflow-x-hidden">
    <div id="heroContainer" class="flex h-fit transition-all duration-300">
      {
        Heros.map((hero) => (
          <HeroHome
            title={hero.title}
            description={hero.description}
            bgImage={hero.bgImage}
            bgImageDesktop={hero.bgImageDesktop}
          />
        ))
      }
    </div>
  </div>
  <ul
    id="heroSelector"
    class="absolute bottom-8 left-0 right-0 mx-auto flex w-fit gap-4 lg:bottom-28"
  >
    <label
      for="heroSelector1"
      id="selectHero1"
      class="h-4 w-4 cursor-pointer rounded-full bg-white-200 shadow-lg transition-colors duration-200 hover:bg-secondary-400"
    >
    </label>
    <label
      for="heroSelector2"
      id="selectHero2"
      class="h-4 w-4 cursor-pointer rounded-full bg-white-200 shadow-lg transition-colors duration-200 hover:bg-secondary-400"
    >
    </label>
    <label
      for="heroSelector3"
      id="selectHero3"
      class="h-4 w-4 cursor-pointer rounded-full bg-white-200 shadow-lg transition-colors duration-200 hover:bg-secondary-400"
    >
    </label>
  </ul>
</div>

<style>
  #sliderControl > input:nth-child(1):checked ~ #heroSlider > #heroContainer {
    transform: translateX(0%);
  }
  #sliderControl > input:nth-child(2):checked ~ #heroSlider > #heroContainer {
    transform: translateX(-100%);
  }
  #sliderControl > input:nth-child(3):checked ~ #heroSlider > #heroContainer {
    transform: translateX(-200%);
  }

  #sliderControl > input:nth-child(1):checked ~ #heroSelector > :nth-child(1),
  #sliderControl > input:nth-child(2):checked ~ #heroSelector > :nth-child(2),
  #sliderControl > input:nth-child(3):checked ~ #heroSelector > :nth-child(3) {
    scale: 1.5;
    background: #4a94a0;
  }
</style>

<script>
  const sliderControl = document.querySelector("#sliderControl");
  const heroContainer = document.querySelector("#heroContainer");
  const heroInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('input[name="heroSelector"]'),
  );

  if (sliderControl && heroContainer && heroInputs.length > 0) {
    let currentHero = heroInputs.findIndex((input) => input.checked);
    let autoplay: ReturnType<typeof window.setInterval>;

    const selectHero = (index: number) => {
      currentHero = index;
      heroInputs[currentHero].checked = true;
      heroContainer.setAttribute(
        "style",
        `transform: translateX(-${currentHero * 100}%);`,
      );
    };

    const startAutoplay = () => {
      window.clearInterval(autoplay);
      autoplay = window.setInterval(() => {
        selectHero((currentHero + 1) % heroInputs.length);
      }, 5000);
    };

    heroInputs.forEach((input, index) => {
      input.addEventListener("change", () => {
        selectHero(index);
        startAutoplay();
      });
    });

    selectHero(Math.max(currentHero, 0));
    startAutoplay();
  }
</script>
