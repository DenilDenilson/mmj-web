---
import { Image } from "astro:assets";
import Asesora from "@src/Images/Home/Vendedora.webp";
import BgAsesoriaHome from "@src/Images/Home/BgAsesoriaHome.avif";
---

<section class="relative">
  <Image
    src={BgAsesoriaHome}
    alt="Fondo de asesoría"
    class="absolute -z-10 h-full w-full object-cover object-center"
  />
  <div class="absolute -z-10 h-full w-full bg-black-900/80"></div>
  <div
    class="mx-auto flex max-w-7xl flex-col items-end gap-4 px-7 md:flex-row md:px-8"
  >
    <article class="my-10 max-w-[624px]">
      <hgroup class="mb-10 text-3xl font-bold text-[#28A0B3] lg:text-2xl">
        <h3 class="text-center font-bold">¿Necesitas Asesoría Técnica?</h3>
        <h3 class="mb-4 text-center font-bold">
          Te Ayudamos a Llevar tus Ideas al Siguiente Nivel
        </h3>
        <p
          class="text-center text-xl font-normal leading-snug tracking-tight text-white-300 lg:leading-normal lg:tracking-normal"
        >
          Te ofrecemos consultoría personalizada para optimizar tus desarrollos
          y maximizar el éxito de tus proyectos en tecnología.
        </p>
      </hgroup>
      <div class="mb-4 grid place-content-center">
        <a
          href="https://wa.link/2gxtsy"
          target="_blank"
          class="grid h-8 place-content-center rounded bg-primary-500 px-4 py-2 text-white-300 lg:h-10"
        >
          Solicita tu prueba piloto
        </a>
        <span class="mt-3 text-sm text-[#DDECEE]"
          >50 % de descuento para nuevos clientes</span
        >
      </div>
      <p class="hidden place-content-center">
        <span class="text-center text-sm text-[#DDECEE] lg:text-start"
          >Descuento del 50% para nuevos clientes</span
        >
      </p>
    </article>
    <div class="relative aspect-square w-full lg:h-80 lg:w-96">
      <Image
        src={Asesora}
        alt={"Imagen de una vendedora"}
        class="absolute bottom-0"
      />
    </div>
  </div>
</section>
