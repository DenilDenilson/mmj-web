---
import Check from "@src/Images/icons/Check.astro";
import BgTrabajoHome from "@src/Images/Home/BgTrabajoHome.avif";
import UneteInges from "@src/Images/Home/UneteInges.webp";
import { Image } from "astro:assets";
---

<section class="relative mt-2">
  <Image
    src={BgTrabajoHome}
    alt="Únete como docente"
    class="absolute -z-10 h-full w-full object-cover object-center"
  />
  <div class="absolute -z-10 h-full w-full bg-black-900/90"></div>
  <div
    class="flex flex-col gap-10 px-4 py-16 lg:mx-auto lg:max-w-7xl lg:flex-row lg:items-center lg:gap-16 lg:px-0"
  >
    <div class="lg:mr-auto lg:max-w-xl">
      <hgroup class="mb-10 text-3xl font-bold text-[#28A0B3] lg:text-2xl">
        <h2 class="mb-4 font-bold">Colabora en Proyectos Innovadores</h2>
        <p
          class="text-pretty text-xl font-light leading-6 tracking-tight text-white-300 lg:leading-normal lg:tracking-normal"
        >
          ¿Te gusta estar en el centro de la acción? Forma parte de nuestro
          equipo en proyectos desafiantes y contribuye al desarrollo de
          soluciones tecnológicas para distintas industrias. Buscamos
          profesionales comprometidos y apasionados por el cambio tecnológico.
        </p>
      </hgroup>
      <div>
        <h4 class="mb-2 text-xl font-bold text-white-200">
          Tu Próximo Desafío Te Espera
        </h4>
        <ul
          class="mb-12 flex flex-col gap-2 text-base font-light text-white-200"
        >
          <li class="flex items-center gap-2">
            <Check />
            <span> Flexibilidad horaria </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Capacitación constante </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Proyectos Desafiantes de Alto Rendimiento </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span>
              Colaborarás con profesionales talentosos y apasionados.
            </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Desarrollo Profesional Acelerado </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Ambiente Creativo y Colaborativo </span>
          </li>
        </ul>
        <a
          href=""
          class="grid h-8 max-w-56 place-content-center rounded bg-primary-500 px-4 py-2 text-white-300 lg:h-10"
          >Explora nuestras vacantes</a
        >
      </div>
    </div>
    <Image
      src={UneteInges}
      alt="Ingenieros de MMJ trabajando en proyectos tecnológicos"
      class="h-72 w-full rounded-lg object-cover object-center lg:h-auto lg:w-1/2"
    />
  </div>
</section>
