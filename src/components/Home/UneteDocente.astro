---
import Check from "@src/Images/icons/Check.astro";
import BgDocenteHome from "@src/Images/Home/BgDocenteHome.avif";
import { Image } from "astro:assets";
---

<section class="relative mt-2">
  <Image
    src={BgDocenteHome}
    alt="Únete como docente"
    class="absolute -z-10 h-full w-full object-cover object-center"
  />
  <div class="absolute -z-10 h-full w-full bg-black-900/90"></div>
  <div class="px-4 py-16 lg:mx-auto lg:max-w-7xl lg:px-0">
    <div class="lg:ml-auto lg:max-w-xl">
      <hgroup class="mb-10 text-3xl font-bold text-[#28A0B3] lg:text-2xl">
        <h2 class="mb-4 font-bold">Sé Parte de Nuestro Equipo Docente</h2>
        <p
          class="text-pretty text-xl font-light leading-6 tracking-tight text-white-300 lg:leading-normal lg:tracking-normal"
        >
          ¿Eres un apasionado de enseñar y compartir conocimientos? Estamos
          buscando expertos en IoT, desarrollo de software, hardware y más.
          Únete a nuestro equipo docente y ayúdanos a formar a la próxima
          generación de profesionales.
        </p>
      </hgroup>
      <div>
        <h4 class="mb-2 text-xl font-bold text-white-200">
          ¿Por qué Formar Parte de Nuestro Equipo?
        </h4>
        <ul
          class="mb-12 flex flex-col gap-2 text-base font-light text-white-200"
        >
          <li class="flex items-center gap-2">
            <Check />
            <span> Flexibilidad horaria </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Capacitación constante </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Plataforma moderna y dinámica </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span> Impacto directo en la formación de profesionales </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span>
              Formarás parte de una comunidad de expertos en tecnología
            </span>
          </li>
          <li class="flex items-center gap-2">
            <Check />
            <span>
              Tendrás la posibilidad de trabajar desde cualquier lugar
            </span>
          </li>
        </ul>
        <a
          href=""
          class="grid h-8 max-w-48 place-content-center rounded bg-primary-500 px-4 py-2 text-white-300 lg:h-10"
          >Aplicar como docente</a
        >
      </div>
    </div>
  </div>
</section>
