---
import UbicationInfo from "./Sections/UbicationInfo.astro";
import UbicationTitle from "./Sections/UbicationTitle.astro";
import BgFormHome from "@src/Images/Home/BgFormHome.avif";
import { Image } from "astro:assets";
---

<section class="relative mt-2">
  <Image
    src={BgFormHome}
    alt="Ubicación"
    class="ubication-bg absolute -z-10 h-full w-full object-cover object-center"
  />
  <div class="absolute -z-10 h-full w-full bg-black-900/80"></div>
  <div
    class="ubication-content mx-auto max-w-7xl overflow-hidden px-7 pb-28 pt-20 md:px-8"
    data-career-reveal
  >
    <UbicationTitle />
    <UbicationInfo />
  </div>
</section>

<style>
  .ubication-bg {
    transform: scale(1.04);
    transition: transform 1400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ubication-content {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 760ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 760ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ubication-content.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  section:has(.ubication-content.is-visible) .ubication-bg {
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .ubication-bg,
    .ubication-content {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const ubicationContent =
    document.querySelector<HTMLElement>(".ubication-content");

  const showUbication = () => {
    ubicationContent?.classList.add("is-visible");
  };

  if (!ubicationContent) {
    // No-op: this keeps the component safe if the markup changes later.
  } else if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    showUbication();
  } else if ("IntersectionObserver" in window) {
    const ubicationObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          showUbication();
          observer.unobserve(entry.target);
        });
      },
      {
        rootMargin: "0px 0px -10% 0px",
        threshold: 0.12,
      },
    );

    ubicationObserver.observe(ubicationContent);
  } else {
    showUbication();
  }
</script>
