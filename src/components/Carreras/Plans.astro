---
import PlansTitle from "./Atoms/PlansTitle.astro";
import PlansBottomText from "./Atoms/PlansBottomText.astro";
import PlansOptions from "./Sections/PlansOptions.astro";
---

<section>
  <div class="mx-auto max-w-7xl px-7 py-16">
    <div class="plans-title-reveal" data-career-reveal>
      <PlansTitle />
    </div>
    <PlansOptions />
    <div class="plans-bottom-reveal" data-career-reveal>
      <PlansBottomText />
    </div>
  </div>
</section>

<style>
  .plans-title-reveal,
  .plans-bottom-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 680ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .plans-bottom-reveal {
    transition-delay: 160ms;
  }

  .plans-title-reveal.is-visible,
  .plans-bottom-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .plans-title-reveal,
    .plans-bottom-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
